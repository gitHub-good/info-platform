economy_zixun({"data": {"total": 437, "list": [{"brief": "今年8月1日起，我国优化实施财政金融协同促内需一揽子政策，进一步激发民间投资活力、提振居民消费。这次政策的亮点是，上调中小微企业贴息贷款额度、扩大贴息覆盖范围。政策落地快两个月了，实际效果怎么样？", "image": "https://p2.img.cctvpic.com/photoworkspace/2026/09/26/2026092607303191315.jpg", "image3": "", "keywords": "红利", "focus_date": "2026-09-26 07:32:07", "ext_field": "", "count": "", "id": "ARTI2IIA6dw2eXTU5iO97yjI260926", "title": "贴息扩围、额度上调 一揽子财政金融政策不断释放红利", "image2": "", "url": "https://news.cctv.com/2026/09/26/ARTI2IIA6dw2eXTU5iO97yjI260926.shtml"}, {"brief": "胶州上合示范区如意湖畔微风轻拂，丝路千古情景区内光影流转、鼓乐悠扬。全景LED矩阵与数控升降舞台联动，全息投影技术还原出千年商港的繁盛图景。", "image": "https://p4.img.cctvpic.com/photoworkspace/2026/09/25/2026092522481225814.jpg", "image3": "", "keywords": "县域 旅游攻略", "focus_date": "2026-09-26 02:48:35", "ext_field": "", "count": "", "id": "ARTIzY9KHrvv01hhqNjjav8O260925", "title": "从“走马观花”到“深度体验”，山东县域游升温", "image2": "", "url": "https://jingji.cctv.com/2026/09/26/ARTIzY9KHrvv01hhqNjjav8O260925.shtml"}, {"brief": "餐厅推出手作月饼体验，研学课堂开进月饼工厂，月饼体验式消费受市场热捧，亲手制作月饼成为中秋消费新亮点。从动手制作到科普研学，多元体验唤醒传统中秋韵味，让月饼不止是舌尖美味，更是可参与、可感受的节日仪式感。", "image": "https://p5.img.cctvpic.com/photoworkspace/2026/09/25/2026092523003594190.jpg", "image3": "", "keywords": "中秋消费观察", "focus_date": "2026-09-26 02:00:53", "ext_field": "", "count": "", "id": "ARTIWTImMQHvaBs1T5ttNg6j260925", "title": "中秋消费观察：手作月饼新亮点争相体验", "image2": "", "url": "https://news.cctv.com/2026/09/26/ARTIWTImMQHvaBs1T5ttNg6j260925.shtml"}, {"brief": "2026年8月28日起，新发布国有建设用地使用权出让公告的商品住房项目优先选择现房销售。对购房者而言，现房可实地查验房屋实景，直观了解户型、品质与配套，有效规避烂尾、交付货不对板等风险，进一步保障购房群众的合法权益。", "image": "https://p4.img.cctvpic.com/photoworkspace/2026/09/25/2026092522440642153.jpg", "image3": "", "keywords": "北京楼市", "focus_date": "2026-09-25 22:44:33", "ext_field": "", "count": "", "id": "ARTIu5l1BPXzA21FaIHYaSr3260925", "title": "央视财经评论 | 现房优先 北京楼市新政利好在哪？", "image2": "", "url": "https://jingji.cctv.com/2026/09/25/ARTIu5l1BPXzA21FaIHYaSr3260925.shtml"}, {"brief": "中秋、国庆假期临近，不少人选择去县城寻觅慢生活，“奔县”逐渐火热。", "image": "https://p1.img.cctvpic.com/photoworkspace/2026/09/24/2026092423312296589.jpg", "image3": "", "keywords": "慢生活 观潮 解锁 视频 古村落 假期 古民居 奔县 海宁观潮 小城", "focus_date": "2026-09-25 04:31:41", "ext_field": "", "count": "", "id": "ARTI5w2NHnpFvJCtJv6Ek0lr260924", "title": "观大潮游古村 假期“奔县”解锁小城慢时光", "image2": "", "url": "https://news.cctv.com/2026/09/25/ARTI5w2NHnpFvJCtJv6Ek0lr260924.shtml"}, {"brief": "中秋临近，在重庆市巴南区丰盛古镇、高新区走马古镇，丰富多彩的民俗活动轮番上演。", "image": "https://p1.img.cctvpic.com/photoworkspace/2026/09/24/2026092421441662529.jpg", "image3": "", "keywords": "古镇 槌打 非遗 特色小吃 沉浸式 市民游客 糖画 扎染 川剧变脸 捏面人", "focus_date": "2026-09-25 04:02:03", "ext_field": "", "count": "", "id": "ARTIghOVOSYS2NEa5Jh9lB3t260924", "title": "逛古镇、赏非遗、品特色小吃……中外友人在重庆沉浸式感受中秋氛围", "image2": "", "url": "https://news.cctv.com/2026/09/25/ARTIghOVOSYS2NEa5Jh9lB3t260924.shtml"}, {"brief": "商务部发布的《中国数字贸易发展报告2026》显示，2025年，中国可数字化交付的服务进出口额达3.1万亿元人民币，同比增长6.6%；跨境电商进出口额达2.84万亿元人民币，同比增长4.8%。", "image": "https://p4.img.cctvpic.com/photoworkspace/2026/09/24/2026092421135696691.jpg", "image3": "", "keywords": "同比增长 贸易增长 出口额达 全球贸易 贸易博览会 全球经济 中国数字贸易发展报告2026 进出口额 全球数字贸易发展报告2026 赋能", "focus_date": "2026-09-25 02:15:26", "ext_field": "", "count": "", "id": "ARTIYVI09pYZY1ZwgJ7YZK9E260924", "title": "2025年全球数字贸易出口额同比增长7.1%", "image2": "", "url": "https://jingji.cctv.com/2026/09/25/ARTIYVI09pYZY1ZwgJ7YZK9E260924.shtml"}, {"brief": "9月24日消息，商务部统计数据显示，2026年1—8月，我国对外承包工程业务完成营业额7937.1亿元人民币，同比增长5.8%（以美元计为1156.1亿美元，增长9.9%），新签合同额11763.2亿元人民币，下降3.0%（以美元计为1713.4亿美元，增长0.7%）。", "image": "https://p2.img.cctvpic.com/photoworkspace/2026/09/24/2026092421004035849.jpg", "image3": "", "keywords": "商务部 增长 人民币", "focus_date": "2026-09-24 21:02:53", "ext_field": "", "count": "", "id": "ARTIjNVwk9yZFtOBA7Ndh9RI260924", "title": "商务部：1—8月我国对外承包工程业务完成营业额7937.1亿元人民币，同比增长5.8%", "image2": "", "url": "https://jingji.cctv.com/2026/09/24/ARTIjNVwk9yZFtOBA7Ndh9RI260924.shtml"}, {"brief": "2025年，国家金融监督管理总局持续指导保险业提升交强险保障功能，积极承担社会责任，助力筑牢民生保障底线，更好服务经济社会发展。", "image": "https://p3.img.cctvpic.com/photoworkspace/2026/09/24/2026092417491538903.jpg", "image3": "", "keywords": "交强险 保险业 同比增长 国家金融 保费收入 参保 助力 社会保障网 机动车数量 降本", "focus_date": "2026-09-24 17:49:28", "ext_field": "", "count": "", "id": "ARTICjz1szJinl1zhHE0IRFY260924", "title": "国家金融监督管理总局：2025年我国交强险赔付2524亿元", "image2": "", "url": "https://jingji.cctv.com/2026/09/24/ARTICjz1szJinl1zhHE0IRFY260924.shtml"}, {"brief": "据商务部消息，中秋、国庆假期临近，商务部召开电视电话会议，组织各地商务主管部门加强生活必需品市场供应保障。", "image": "https://p1.img.cctvpic.com/photoworkspace/2026/09/24/2026092417473930006.jpg", "image3": "", "keywords": "商务部 必需品 供应", "focus_date": "2026-09-24 17:49:21", "ext_field": "", "count": "", "id": "ARTILt77oMbQpyHPvzxEO3Ws260924", "title": "商务部门加强中秋国庆生活必需品市场供应保障", "image2": "", "url": "https://news.cctv.com/2026/09/24/ARTILt77oMbQpyHPvzxEO3Ws260924.shtml"}]}})